# Traject - IndiaAI Qwen only; do not commit backend/.env
DB_PATH=data/traject.db
API_KEY_SALT=replace-with-a-long-random-secret-before-public-deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

INDIAAI_API_KEY=
INDIAAI_BASE_URL=https://YOUR_AUTHORIZED_GATEWAY/v1
INDIAAI_MODEL=qwen-3.8-27b
INDIAAI_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
INDIAAI_CONCURRENCY=1
INDIAAI_JSON_MODE=1
# Non-standard Qwen thinking toggle, if supported by your gateway.
INDIAAI_DISABLE_THINKING=1
INDIAAI_THINKING_PARAM=chat_template_kwargs
INDIAAI_TEST_MAX_TOKENS=1024
